---
import { isRTL } from '@/i18n/rtl';

interface Props {
  lang: string;
  sections: Array<{ id: string; title: string }>;
  currentId?: string;
  messages: any;
}

const { lang, sections, currentId, messages } = Astro.props as Props;
const rtl = isRTL(lang);
const tocTitle = messages.docs?.toc?.title || messages.docs?.whitepaper?.toc?.title || '目錄';
---

<aside class="docs-sidebar-wrapper">
  <!-- 收縮按鈕（桌面端） -->
  <button 
    id="sidebar-toggle"
    class="sidebar-toggle hidden lg:flex"
    aria-label="Toggle sidebar"
  >
    <span id="toggle-icon">◀</span>
  </button>
  
  <nav 
    id="docs-sidebar"
    class="docs-sidebar"
    aria-label="Table of Contents"
    dir={rtl ? 'rtl' : 'ltr'}
  >
    <h2 class="text-sm font-semibold mb-3">{tocTitle}</h2>
    <ul class="space-y-1">
      {sections.map((section) => (
        <li>
          <a 
            href={`#${section.id}`}
            class={currentId === section.id ? 'active' : ''}
          >
            {section.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  // 側邊欄收縮功能（客戶端）
  const toggle = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('docs-sidebar');
  const icon = document.getElementById('toggle-icon');
  
  if (toggle && sidebar && icon) {
    toggle.addEventListener('click', () => {
      sidebar.classList.toggle('collapsed');
      const isCollapsed = sidebar.classList.contains('collapsed');
      icon.textContent = isCollapsed ? '▶' : '◀';
      localStorage.setItem('docs-sidebar-collapsed', isCollapsed ? 'true' : 'false');
    });
    
    // 恢復上次狀態
    if (localStorage.getItem('docs-sidebar-collapsed') === 'true') {
      sidebar.classList.add('collapsed');
      icon.textContent = '▶';
    }
  }
</script>

<style>
  .docs-sidebar-wrapper {
    position: relative;
    flex-shrink: 0;
  }
  
  .sidebar-toggle {
    position: absolute;
    inset-inline-start: 100%;
    top: 0;
    padding: 0.5rem;
    background: var(--card-bg);
    border: 1px solid var(--card-ring);
    border-radius: 0 0.5rem 0.5rem 0;
    cursor: pointer;
    z-index: 10;
    transition: inset-inline-start 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
  }
  
  /* RTL 支持 */
  [dir="rtl"] .sidebar-toggle {
    border-radius: 0.5rem 0 0 0.5rem;
  }
  
  .sidebar-toggle:hover {
    background: var(--card-ring);
  }
  
  .docs-sidebar {
    position: sticky;
    top: 4rem; /* Header 高度 */
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1rem;
    width: 240px;
    transition: width 0.3s ease, padding 0.3s ease, opacity 0.3s ease;
    white-space: nowrap;
    background: var(--card-bg);
    border: 1px solid var(--card-ring);
    border-radius: 0.5rem;
  }
  
  /* 收縮狀態：側邊欄寬度變為 0，主內容自動填充 */
  .docs-sidebar.collapsed {
    width: 0;
    padding-inline: 0;
    opacity: 0;
    overflow: hidden;
    border: none;
  }
  
  /* 收縮時，切換按鈕位置調整 */
  .docs-sidebar-wrapper:has(.docs-sidebar.collapsed) .sidebar-toggle {
    inset-inline-start: 0;
    border-radius: 0.5rem 0 0 0.5rem;
  }
  
  [dir="rtl"] .docs-sidebar-wrapper:has(.docs-sidebar.collapsed) .sidebar-toggle {
    border-radius: 0 0.5rem 0.5rem 0;
  }
  
  .docs-sidebar h2 {
    color: var(--text);
    margin-bottom: 0.75rem;
    font-family: 'Sora', system-ui, sans-serif;
  }
  
  .docs-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .docs-sidebar a {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--text-subtle);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  
  .docs-sidebar a:hover {
    background-color: var(--card-ring);
    color: var(--text);
  }
  
  .docs-sidebar a.active {
    background-color: var(--card-ring);
    color: var(--text);
    font-weight: 600;
  }
  
  /* 移動端隱藏，使用頂部折疊菜單替代 */
  @media (max-width: 1023px) {
    .docs-sidebar-wrapper {
      display: none;
    }
  }
  
  /* RTL 支持 */
  [dir="rtl"] .docs-sidebar {
    direction: rtl;
  }
</style>

