---
import { isRTL } from '@/i18n/rtl';

interface Props {
  lang: string;
  sections: Array<{ id: string; title: string }>;
  currentId?: string;
  messages: any;
}

const { lang, sections, currentId, messages } = Astro.props as Props;
const rtl = isRTL(lang);
const tocTitle = messages.docs?.litepaper?.toc?.title || messages.docs?.toc?.title || '目錄';
---

<aside class="litepaper-sidebar-wrapper">
  <!-- 收縮按鈕（桌面端） -->
  <button 
    id="litepaper-sidebar-toggle"
    class="litepaper-sidebar-toggle hidden lg:flex"
    aria-label="Toggle sidebar"
  >
    <span id="litepaper-toggle-icon">◀</span>
  </button>
  
  <nav 
    id="litepaper-sidebar"
    class="litepaper-sidebar"
    aria-label="Table of Contents"
    dir={rtl ? 'rtl' : 'ltr'}
  >
    <h2 class="text-sm font-semibold mb-3 text-text">{tocTitle}</h2>
    <ul class="space-y-1">
      {sections.map((section) => (
        <li>
          <a 
            href={`#${section.id}`}
            class={`litepaper-toc-link ${currentId === section.id ? 'active' : ''}`}
            data-section-id={section.id}
          >
            {section.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  // 側邊欄收縮功能（客戶端）
  const toggle = document.getElementById('litepaper-sidebar-toggle');
  const sidebar = document.getElementById('litepaper-sidebar');
  const icon = document.getElementById('litepaper-toggle-icon');
  
  if (toggle && sidebar && icon) {
    toggle.addEventListener('click', () => {
      sidebar.classList.toggle('collapsed');
      const isCollapsed = sidebar.classList.contains('collapsed');
      icon.textContent = isCollapsed ? '▶' : '◀';
      localStorage.setItem('litepaper-sidebar-collapsed', isCollapsed ? 'true' : 'false');
    });
    
    // 恢復上次狀態
    if (localStorage.getItem('litepaper-sidebar-collapsed') === 'true') {
      sidebar.classList.add('collapsed');
      icon.textContent = '▶';
    }
  }

  // 平滑滾動處理
  const tocLinks = document.querySelectorAll('.litepaper-toc-link');
  tocLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href')?.substring(1); // 移除 #
      if (targetId) {
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          const headerOffset = 80; // Header 高度
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      }
    });
  });
</script>

<style>
  .litepaper-sidebar-wrapper {
    position: relative;
    flex-shrink: 0;
  }
  
  .litepaper-sidebar-toggle {
    position: absolute;
    inset-inline-start: 100%;
    top: 0;
    padding: 0.5rem;
    background: var(--card-bg);
    border: 1px solid var(--card-ring);
    border-radius: 0 0.5rem 0.5rem 0;
    cursor: pointer;
    z-index: 10;
    transition: inset-inline-start 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--text);
  }
  
  /* RTL 支持 */
  [dir="rtl"] .litepaper-sidebar-toggle {
    border-radius: 0.5rem 0 0 0.5rem;
  }
  
  .litepaper-sidebar-toggle:hover {
    background: var(--card-ring);
  }
  
  .litepaper-sidebar {
    position: sticky;
    top: 4rem; /* Header 高度 */
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1rem;
    width: 240px;
    transition: width 0.3s ease, padding 0.3s ease, opacity 0.3s ease;
    white-space: nowrap;
    background: var(--card-bg);
    border: 1px solid var(--card-ring);
    border-radius: 0.5rem;
  }
  
  /* 收縮狀態：側邊欄寬度變為 0，主內容自動填充 */
  .litepaper-sidebar.collapsed {
    width: 0;
    padding-inline: 0;
    opacity: 0;
    overflow: hidden;
    border: none;
  }
  
  /* 收縮時，切換按鈕位置調整 */
  .litepaper-sidebar-wrapper:has(.litepaper-sidebar.collapsed) .litepaper-sidebar-toggle {
    inset-inline-start: 0;
    border-radius: 0.5rem 0 0 0.5rem;
  }
  
  [dir="rtl"] .litepaper-sidebar-wrapper:has(.litepaper-sidebar.collapsed) .litepaper-sidebar-toggle {
    border-radius: 0 0.5rem 0.5rem 0;
  }
  
  .litepaper-sidebar h2 {
    color: var(--text);
    margin-bottom: 0.75rem;
    font-family: 'Sora', system-ui, sans-serif;
  }
  
  .litepaper-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .litepaper-toc-link {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--text-subtle);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.2s ease, color 0.2s ease, border-inline-start 0.2s ease;
    border-inline-start: 3px solid transparent;
  }
  
  .litepaper-toc-link:hover {
    background-color: var(--card-ring);
    color: var(--text);
  }
  
  .litepaper-toc-link.active {
    background-color: var(--card-ring);
    color: var(--primary);
    font-weight: 600;
    border-inline-start-color: var(--primary);
  }
  
  /* 移動端隱藏，使用頂部折疊菜單替代 */
  @media (max-width: 1023px) {
    .litepaper-sidebar-wrapper {
      display: none;
    }
  }
  
  /* RTL 支持 */
  [dir="rtl"] .litepaper-sidebar {
    direction: rtl;
  }
</style>

