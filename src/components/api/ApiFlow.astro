---
import { isRTL } from '@/i18n/rtl';

interface Props {
  texts: {
    user: string;
    moonpacket: string;
    dev_api: string;
    step1: string;
    step2: string;
    click: string;
    check: string;
    grant: string;
    client_app: string;
    json_data: string;
    saved_rule: string;
    user_state: string;
  };
}

const { texts } = Astro.props;
---

<div class="w-full overflow-hidden py-10">
  <div class="relative max-w-[900px] mx-auto min-w-[700px]"> <!-- min-w to ensure text doesn't wrap weirdly on mobile -->
    <svg viewBox="0 0 900 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
      
      <!-- Defs for Gradients and Markers -->
      <defs>
        <linearGradient id="grad-mp" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFD700" stop-opacity="0.2" />
          <stop offset="100%" stop-color="#FFD700" stop-opacity="0.05" />
        </linearGradient>
        <linearGradient id="grad-dev" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.2" />
          <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.05" />
        </linearGradient>
        
        <marker id="arrow-gold" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L0,6 L9,3 z" fill="#FFD700" />
        </marker>
        <marker id="arrow-blue" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L0,6 L9,3 z" fill="#3B82F6" />
        </marker>
        <filter id="glow-soft" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="5" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- Connection Lines -->
      
      <!-- Step 1 Flow: Config Phase (Dotted) -->
      <path d="M300 120 C 450 120, 450 120, 600 120" stroke="url(#line-grad-1)" stroke-width="2" stroke-dasharray="4 4" marker-end="url(#arrow-gold)">
         <animate attributeName="stroke-dashoffset" from="100" to="0" dur="3s" repeatCount="indefinite" />
      </path>
      <linearGradient id="line-grad-1" gradientUnits="userSpaceOnUse" x1="300" y1="120" x2="600" y2="120">
        <stop offset="0" stop-color="#FFD700" stop-opacity="0.1"/>
        <stop offset="1" stop-color="#FFD700" stop-opacity="0.6"/>
      </linearGradient>
      
      <!-- Step 2 Flow: Runtime Phase (Solid, Active) -->
      <path d="M300 280 C 450 280, 450 280, 600 280" stroke="url(#line-grad-2)" stroke-width="3" marker-end="url(#arrow-gold)">
         <animate attributeName="stroke-dashoffset" from="100" to="0" dur="1.5s" repeatCount="indefinite" />
      </path>
      <linearGradient id="line-grad-2" gradientUnits="userSpaceOnUse" x1="300" y1="280" x2="600" y2="280">
        <stop offset="0" stop-color="#FFD700" stop-opacity="0.2"/>
        <stop offset="1" stop-color="#FFD700" stop-opacity="1"/>
      </linearGradient>

      <!-- Return Flow: Dev -> MP (Middle) -->
      <path d="M600 200 C 450 200, 450 200, 300 200" stroke="#3B82F6" stroke-width="2" stroke-opacity="0.3" marker-end="url(#arrow-blue)" />


      <!-- NODES -->

      <!-- Node 1: Moonpacket App (Left) -->
      <g transform="translate(50, 50)">
        <rect x="0" y="0" width="250" height="300" rx="20" fill="#1E1E1E" stroke="#FFD700" stroke-width="2" filter="url(#glow-soft)" />
        <rect x="0" y="0" width="250" height="300" rx="20" fill="url(#grad-mp)" />
        
        <!-- Header -->
        <text x="125" y="40" text-anchor="middle" fill="#FFD700" font-size="20" font-weight="bold" class="brand-word">moonpacket</text>
        <text x="125" y="60" text-anchor="middle" fill="#94A3B8" font-size="12">{texts.client_app}</text>
        
        <!-- Internal Logic Box -->
        <g transform="translate(25, 180)">
            <rect x="0" y="0" width="200" height="100" rx="10" fill="rgba(255,255,255,0.05)" stroke="#FFD700" stroke-opacity="0.3" stroke-dasharray="4 4" />
            <text x="100" y="25" text-anchor="middle" fill="#FFD700" font-size="12" opacity="0.8">{texts.check}</text>
            <line x1="20" y1="40" x2="180" y2="40" stroke="#FFFFFF" stroke-opacity="0.1" />
            
            <!-- Logic Details -->
            <text x="30" y="60" fill="#FFD700" font-size="10" opacity="0.8">{texts.saved_rule}</text>
            <text x="170" y="60" text-anchor="end" fill="#E2E8F0" font-size="10">Level >= 10</text>
            
            <text x="30" y="75" fill="#3B82F6" font-size="10" opacity="0.8">{texts.user_state}</text>
            <text x="170" y="75" text-anchor="end" fill="#E2E8F0" font-size="10">Level = 12</text>
            
            <text x="100" y="92" text-anchor="middle" fill="#10B981" font-size="12" font-weight="bold">✓ {texts.grant}</text>
        </g>
      </g>

      <!-- Node 2: Dev API (Right) -->
      <g transform="translate(600, 100)">
        <rect x="0" y="0" width="200" height="200" rx="15" fill="url(#grad-dev)" stroke="#3B82F6" stroke-width="1" />
        <text x="100" y="40" text-anchor="middle" fill="#3B82F6" font-size="24">⚙️</text>
        <text x="100" y="70" text-anchor="middle" fill="#E2E8F0" font-size="14" font-weight="bold">{texts.dev_api}</text>
        
        <!-- Endpoints -->
        <rect x="25" y="100" width="150" height="30" rx="5" fill="#3B82F6" fill-opacity="0.2" />
        <text x="100" y="120" text-anchor="middle" fill="#93C5FD" font-size="10" font-family="monospace">GET /check</text>
        
        <rect x="25" y="140" width="150" height="30" rx="5" fill="#3B82F6" fill-opacity="0.2" />
        <text x="100" y="160" text-anchor="middle" fill="#93C5FD" font-size="10" font-family="monospace">?user_id=...</text>
      </g>


      <!-- Labels -->
      
      <!-- Label: Step 1 -->
      <g transform="translate(350, 90)">
         <rect x="0" y="0" width="200" height="26" rx="13" fill="#1E1E1E" stroke="#FFD700" stroke-opacity="0.3" />
         <text x="100" y="18" text-anchor="middle" fill="#FFD700" font-size="11" font-weight="bold">{texts.step1}</text>
      </g>

      <!-- Label: Step 2 -->
      <g transform="translate(350, 290)">
         <rect x="0" y="0" width="200" height="26" rx="13" fill="#1E1E1E" stroke="#10B981" stroke-opacity="0.3" />
         <text x="100" y="18" text-anchor="middle" fill="#10B981" font-size="11" font-weight="bold">{texts.step2}</text>
      </g>
      
      <!-- Response Label -->
      <text x="450" y="215" text-anchor="middle" fill="#3B82F6" font-size="10" opacity="0.8">{texts.json_data}</text>

    </svg>
    
    <!-- Mobile Scroll Hint -->
    <div class="md:hidden text-center text-xs text-[var(--text-subtle)] mt-2 animate-pulse">
       ← 左右滑動查看流程 →
    </div>
  </div>
</div>
