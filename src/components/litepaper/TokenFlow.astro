---
interface Props {
  labels: {
    title: string;
    userSend: string;
    fee: string;
    operations: string;
    pol: string;
    accumulate: string;
    trigger: string;
    swap: string;
    addLiquidity: string;
    pool: string;
    smart_floor?: string;
  }
}

const { labels } = Astro.props;

// Fallback labels
const l = {
  userSend: labels?.userSend || 'User',
  fee: labels?.fee || 'Fee',
  operations: labels?.operations || 'Ops',
  pol: labels?.pol || 'Floor Defense',
  accumulate: labels?.accumulate || 'Accumulate',
  swap: labels?.swap || 'Buyback',
  pool: labels?.pool || 'Pool',
  smart_floor: labels?.smart_floor || 'Smart Floor Defense',
};
---

<div class="relative w-full max-w-5xl mx-auto rounded-3xl border border-[var(--card-ring)]/50 bg-[var(--card-bg)]/20 backdrop-blur-sm overflow-hidden group">
  
  {/* Mobile Scroll Hint */}
  <div class="md:hidden absolute top-3 right-3 z-10 px-3 py-1 text-xs font-medium text-[var(--text-subtle)] bg-[var(--bg-dark)]/80 backdrop-blur-md rounded-full border border-[var(--card-ring)] shadow-sm pointer-events-none opacity-80">
    ← 左右滑動查看 →
  </div>

  <div class="overflow-x-auto w-full scrollbar-hide">
    <div class="min-w-[700px] md:min-w-0 md:w-full aspect-[21/9] p-1 md:p-0">
      <svg 
        viewBox="0 0 800 340" 
        width="800" 
        height="340"
        class="w-full h-full block" 
        fill="none" 
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid meet"
      >
    <defs>
      <linearGradient id="tf-grad-gold" x1="0" y1="0" x2="100%" y2="0">
        <stop offset="0%" stop-color="var(--gold)" stop-opacity="0.8" />
        <stop offset="100%" stop-color="var(--primary)" stop-opacity="0.8" />
      </linearGradient>
      
      <!-- Arrow Marker -->
      <marker id="tf-arrow-gold" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="var(--gold)" />
      </marker>
    </defs>

    <!-- 1. User Action (Left) -->
    <g transform="translate(50, 130)">
      <rect width="140" height="60" rx="12" fill="var(--card-bg)" stroke="var(--primary)" stroke-width="2" fill-opacity="0.8" />
      <text x="70" y="30" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="10" dominant-baseline="middle" dy="2">{l.userSend}</text>
    </g>

    <!-- Path: User -> Fee -->
    <path d="M190 160 H260" stroke="var(--text-subtle)" stroke-width="2" marker-end="url(#tf-arrow-gold)" stroke-dasharray="4 4" />

    <!-- 2. Fee Logic (Center) -->
    <g transform="translate(260, 110)">
      <circle cx="50" cy="50" r="45" fill="var(--bg-dark)" stroke="var(--gold)" stroke-width="2" />
      <text x="50" y="50" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="10" dominant-baseline="middle">{l.fee}</text>
    </g>

    <!-- Path: Fee -> Ops (Up) -->
    <path d="M310 110 Q350 60 400 60" stroke="var(--text-subtle)" stroke-width="2" stroke-dasharray="2 2" />
    
    <!-- Path: Fee -> POL (Down - MAIN PATH) -->
    <path d="M310 210 Q310 250 400 250" stroke="url(#tf-grad-gold)" stroke-width="2" marker-end="url(#tf-arrow-gold)" />

    <!-- 3. Operations (Top) -->
    <g transform="translate(400, 30)">
      <rect width="120" height="50" rx="8" fill="var(--card-bg)" stroke="var(--card-ring)" />
      <text x="60" y="25" text-anchor="middle" fill="var(--text-subtle)" font-size="12" dominant-baseline="middle">{l.operations}</text>
    </g>

    <!-- 4. POL / Floor Defense (Bottom - Highlighted) -->
    <g transform="translate(400, 180)">
      <!-- Background Container -->
      <rect width="300" height="120" rx="16" fill="var(--bg-dark)" stroke="var(--gold)" stroke-width="2" />
      <text x="150" y="30" text-anchor="middle" fill="var(--gold)" font-weight="bold" font-size="16">🛡️ {l.pol}</text>
      
      <!-- Accumulate Box -->
      <g transform="translate(30, 50)">
         <rect width="90" height="40" rx="6" fill="var(--primary)" fill-opacity="0.2" stroke="var(--primary)" />
         <text x="45" y="20" text-anchor="middle" fill="var(--primary)" font-size="11" dominant-baseline="middle" dy="1">{l.accumulate}</text>
      </g>

      <!-- Arrow -->
      <path d="M120 70 H150" stroke="var(--gold)" stroke-width="2" marker-end="url(#tf-arrow-gold)" />

      <!-- Buyback Box -->
      <g transform="translate(150, 50)">
         <rect width="120" height="40" rx="6" fill="var(--gold)" fill-opacity="0.2" stroke="var(--gold)" />
         <text x="60" y="20" text-anchor="middle" fill="var(--gold)" font-weight="bold" font-size="12" dominant-baseline="middle" dy="1">{l.swap}</text>
      </g>
      
      <!-- Subtext -->
      <text x="150" y="105" text-anchor="middle" fill="var(--text-subtle)" font-size="10" font-style="italic">"{l.smart_floor}"</text>
    </g>

    <!-- Path: POL -> LP (Return) -->
    <path d="M700 240 H740 V135 H700" stroke="var(--gold)" stroke-width="2" stroke-dasharray="4 4" marker-end="url(#tf-arrow-gold)" />

    <!-- 5. Liquidity Pool (Right) -->
    <g transform="translate(560, 100)">
      <rect width="140" height="70" rx="35" fill="url(#tf-grad-gold)" fill-opacity="0.1" stroke="var(--gold)" stroke-width="2" />
      <text x="70" y="35" text-anchor="middle" fill="var(--text)" font-weight="bold" font-size="12" dominant-baseline="middle" dy="2">{l.pool}</text>
    </g>

    </svg>
    </div>
  </div>
</div>
