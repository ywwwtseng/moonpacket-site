---
/**
 * 白皮書主頁面
 * 集成所有組件：倒計時、免責聲明、側邊欄、圖表
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { computeCanonical } from '@/utils/head';
import { getLocalesForBuild, defaultLocale } from '@/i18n/locales.config';
import { LOCALE_ORDER } from '@/config/locales';
import { isRTL } from '@/i18n/rtl';
import { brandify } from '@/lib/brandify';
import { htmlWithLineBreaks } from '@/utils/text';
import { ensureArray } from '@/utils/normalize';
import Section from '@/components/Section.astro';
import CountdownBanner from '@/components/CountdownBanner.astro';
import DisclaimerBanner from '@/components/DisclaimerBanner.astro';
import DocsSidebar from '@/components/DocsSidebar.astro';
import MobileTOC from '@/components/MobileTOC.astro';
import { shouldShowCountdown, TOKEN_LAUNCH_CONFIG } from '@/config/token-launch';

// 圖表組件
import AllocationPieChart from '@/islands/charts/AllocationPieChart';
import PhaseReductionChart from '@/islands/charts/PhaseReductionChart';
import VestingTimelineChart from '@/islands/charts/VestingTimelineChart';
import GovernanceFlowchart from '@/components/charts/GovernanceFlowchart.astro';
import ContractArchitectureDiagram from '@/components/charts/ContractArchitectureDiagram.astro';
import TokenFlowDiagram from '@/components/charts/TokenFlowDiagram.astro';

// Helper: 保留換行為 <br/> 並品牌化
const toHTML = (s?: string) => htmlWithLineBreaks(brandify(s ?? ""));
// 物件/字串/陣列 皆轉為字串陣列
function toLines(value: any): string[] {
  try {
    if (!value) return [];
    if (Array.isArray(value)) return value.map(String);
    if (typeof value === 'string') {
      return value.replace(/\\n/g, '\n').split(/\r?\n/).map(s => s.trim());
    }
    if (typeof value === 'object') {
      return Object.keys(value).sort((a,b)=>Number(a)-Number(b)).map(k=>String(value[k]));
    }
    return [];
  } catch { return []; }
}

// Helper: 檢測並渲染 Markdown 表格
function parseTableLines(lines: string[]): { isTable: boolean; tableRows: string[][]; restLines: string[] } {
  const tableRows: string[][] = [];
  let tableStart = -1;
  let tableEnd = -1;
  
  // 找到表格的開始和結束
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].startsWith('|') && lines[i].endsWith('|')) {
      if (tableStart === -1) tableStart = i;
      tableEnd = i;
    } else if (tableStart !== -1) {
      // 遇到非表格行，表格結束
      break;
    }
  }
  
  if (tableStart === -1) {
    return { isTable: false, tableRows: [], restLines: lines };
  }
  
  // 提取表格行
  for (let i = tableStart; i <= tableEnd; i++) {
    const cells = lines[i].split('|').filter(c => c.trim());
    if (cells.length > 0) {
      tableRows.push(cells.map(c => c.trim()));
    }
  }
  
  // 剩餘的行
  const restLines = [
    ...lines.slice(0, tableStart),
    ...lines.slice(tableEnd + 1)
  ];
  
  return { isTable: tableRows.length > 0, tableRows, restLines };
}

export async function getStaticPaths() {
  const locales = getLocalesForBuild();
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: string };
const messages = await import('@/i18n/loadMessages')
  .then((m) => m.loadAllMessages(lang as any))
  .catch(async () => {
    const fallback = await import('@/i18n/loadMessages').then((m) =>
      m.loadAllMessages(defaultLocale),
    );
    return fallback;
  });

const docsMessages = messages.docs || {};
const whitepaperMessages = docsMessages.whitepaper || {};
const rtl = isRTL(lang);

// SEO metadata（必須從 i18n 讀取）
const seoTitle = messages.site?.seo?.routes?.docs?.whitepaper?.title 
  || whitepaperMessages?.seo?.title 
  || whitepaperMessages?.title 
  || '';
const seoDescription = messages.site?.seo?.routes?.docs?.whitepaper?.description 
  || whitepaperMessages?.seo?.description 
  || whitepaperMessages?.description 
  || '';

const canonical = computeCanonical(
  Astro.url, 
  (Astro.site && Astro.site.toString()) || undefined
);

// 章節列表（用於側邊欄和 TOC）
const sections = [
  { id: 'overview', title: whitepaperMessages?.sections?.overview || '' },
  { id: 'tokenomics', title: whitepaperMessages?.sections?.tokenomics || '' },
  { id: 'architecture', title: whitepaperMessages?.sections?.architecture || '' },
  { id: 'emission', title: whitepaperMessages?.sections?.emission || '' },
  { id: 'governance', title: whitepaperMessages?.sections?.governance || '' },
  { id: 'incentives', title: whitepaperMessages?.sections?.incentives || '' },
  { id: 'developer', title: whitepaperMessages?.sections?.developer || '' },
  { id: 'roadmap', title: whitepaperMessages?.sections?.roadmap || '' },
  { id: 'risks', title: whitepaperMessages?.sections?.risks || '' },
  { id: 'faq', title: whitepaperMessages?.sections?.faq || '' },
].filter(s => s.title); // 過濾空標題

// 圖表標籤（從 i18n 讀取）
const chartLabels = {
  allocation: whitepaperMessages?.charts?.allocation || {},
  phase: whitepaperMessages?.charts?.phase || {},
  vesting: whitepaperMessages?.charts?.vesting || {},
  flow: whitepaperMessages?.charts?.flow || {},
  governance: whitepaperMessages?.charts?.governance || {},
  architecture: whitepaperMessages?.charts?.architecture || {},
};

// 品牌化標題
const whitepaperTitle = brandify(whitepaperMessages?.title || '');
const showCountdown = shouldShowCountdown();
---

<BaseLayout 
  lang={lang} 
  title={seoTitle}
  description={seoDescription}
  canonicalUrl={canonical}
  allLocales={LOCALE_ORDER}
  rtl={rtl}
>
  <main id="main-content">
    <!-- Hero 區域 -->
    <section id="hero" class="relative mx-auto max-w-6xl px-4 py-6 overflow-visible">
      <h1 class="text-3xl font-bold mb-4" set:html={whitepaperTitle}></h1>
      <p class="text-lg text-textSubtle mb-8" set:html={toHTML(whitepaperMessages?.hero?.subtitle || whitepaperMessages?.description || '')}></p>
      
      <!-- 三張卡片 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="p-6 rounded-xl bg-white shadow-sm ring-1 ring-black/5 dark:ring-card-ring border border-card-ring transition-shadow hover:shadow-md">
          <h3 class="text-lg font-semibold mb-2 text-text">{whitepaperMessages?.hero?.cards?.user?.title || ''}</h3>
          <p class="text-sm text-textSubtle leading-relaxed">{whitepaperMessages?.hero?.cards?.user?.description || ''}</p>
        </div>
        <div class="p-6 rounded-xl bg-white shadow-sm ring-1 ring-black/5 dark:ring-card-ring border border-card-ring transition-shadow hover:shadow-md">
          <h3 class="text-lg font-semibold mb-2 text-text">{whitepaperMessages?.hero?.cards?.investor?.title || ''}</h3>
          <p class="text-sm text-textSubtle leading-relaxed">{whitepaperMessages?.hero?.cards?.investor?.description || ''}</p>
        </div>
        <div class="p-6 rounded-xl bg-white shadow-sm ring-1 ring-black/5 dark:ring-card-ring border border-card-ring transition-shadow hover:shadow-md">
          <h3 class="text-lg font-semibold mb-2 text-text">{whitepaperMessages?.hero?.cards?.developer?.title || ''}</h3>
          <p class="text-sm text-textSubtle leading-relaxed">{whitepaperMessages?.hero?.cards?.developer?.description || ''}</p>
        </div>
      </div>
    </section>

    <!-- 倒計時區塊（條件顯示） -->
    {showCountdown && (
      <div class="mx-auto max-w-6xl px-4">
        <CountdownBanner messages={messages} />
      </div>
    )}

    <!-- 免責聲明區塊 -->
    <div class="mx-auto max-w-6xl px-4">
      <DisclaimerBanner messages={messages} />
    </div>

    <!-- 主內容區 -->
    <Section class="py-10">
      <!-- 移動端 TOC（可折疊） -->
      <div class="mb-6 lg:hidden">
        <MobileTOC lang={lang} sections={sections} messages={messages} />
      </div>

      <!-- 使用 Flexbox 布局，確保側邊欄收縮後主內容自動調整 -->
      <div class="flex flex-col lg:flex-row gap-6">
        <!-- 桌面端側邊欄 -->
        <aside class="hidden lg:block flex-shrink-0">
          <DocsSidebar lang={lang} sections={sections} messages={messages} />
        </aside>

        <!-- 主內容（自動填充剩餘空間） -->
        <article class="flex-1 min-w-0">
          <div class="rounded-xl bg-white shadow-sm ring-1 ring-black/5 dark:ring-card-ring p-5">
            <div class="text-base text-textSubtle leading-relaxed space-y-8 legal-prose">
              
              <!-- 一、項目概述 -->
              <section id="overview" class="prose dark:prose-invert max-w-none">
                <h2 class="text-xl font-semibold mb-4" set:html={brandify(whitepaperMessages?.sections?.overview || '')}></h2>
                
                <h3 class="text-lg font-semibold mb-3">1.1 什麼是 $moonini？</h3>
                <div class="mb-4">
                  {toLines(whitepaperMessages?.content?.overview?.what_is || []).map((item: string) => {
                    if (item.trim() === '') {
                      return <br />;
                    }
                    if (item.startsWith('- ')) {
                      return <li class="ml-4" set:html={toHTML(item)} />;
                    }
                    return <p class="mb-2" set:html={toHTML(item)} />;
                  })}
                </div>

                <h3 class="text-lg font-semibold mb-3">{whitepaperMessages?.content?.overview?.core_values?.title || '1.2 核心價值'}</h3>
                <ul class="list-disc pl-6 mb-4">
                  {toLines(whitepaperMessages?.content?.overview?.core_values?.values || []).map((item: string) => (
                    <li class="mb-1" set:html={toHTML(item)} />
                  ))}
                </ul>
              </section>

              <!-- 二、代幣經濟學 -->
              <section id="tokenomics" class="prose dark:prose-invert max-w-none">
                <h2 class="text-xl font-semibold mb-4" set:html={brandify(whitepaperMessages?.sections?.tokenomics || '')}></h2>
                
                <h3 class="text-lg font-semibold mb-3">{whitepaperMessages?.content?.tokenomics?.info?.title || '2.1 代幣基本信息'}</h3>
                <div class="mb-4">
                  {(() => {
                    const lines = toLines(whitepaperMessages?.content?.tokenomics?.info?.description || []);
                    const { isTable, tableRows, restLines } = parseTableLines(lines);
                    
                    if (isTable && tableRows.length > 0) {
                      const headerRow = tableRows[0];
                      const dataRows = tableRows.slice(1).filter(row => !row.every(cell => /^:?-+:?$/.test(cell))); // 過濾分隔符行
                      
                      return (
                        <>
                          {restLines.map((line: string) => {
                            if (line.trim() === '') return <br />;
                            return <p class="mb-2" set:html={toHTML(line)} />;
                          })}
                          <div class="overflow-x-auto my-4">
                            <table class="w-full min-w-[400px] text-sm border-collapse">
                              <thead class="bg-black/5 dark:bg-black/10 text-left">
                                <tr>
                                  {headerRow.map((cell: string) => (
                                    <th class="px-3 py-2 border border-card-ring font-semibold" set:html={toHTML(cell)}></th>
                                  ))}
                                </tr>
                              </thead>
                              <tbody>
                                {dataRows.map((row: string[]) => (
                                  <tr class="border-b border-card-ring even:bg-black/5 dark:even:bg-black/10">
                                    {row.map((cell: string) => (
                                      <td class="px-3 py-2 border border-card-ring" set:html={toHTML(cell)}></td>
                                    ))}
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </>
                      );
                    }
                    
                    return lines.map((item: string) => {
                      if (item.trim() === '') return <br />;
                      return <p class="mb-2" set:html={toHTML(item)} />;
                    });
                  })()}
                </div>

                <h3 class="text-lg font-semibold mb-3">{whitepaperMessages?.content?.tokenomics?.allocation?.title || '2.2 分配方案'}</h3>
                <div class="mb-4">
                  {toLines(whitepaperMessages?.content?.tokenomics?.allocation?.description || []).map((item: string) => {
                    if (item.trim() === '') {
                      return <br />;
                    }
                    if (item.startsWith('- ')) {
                      return <li class="ml-4 mb-1" set:html={toHTML(item)} />;
                    }
                    return <p class="mb-2" set:html={toHTML(item)} />;
                  })}
                </div>
                
                <!-- 圖表：代幣分配餅圖（位置：第二章 2.2「分配方案」→ 表格之前） -->
                <div class="chart-container my-6">
                  <AllocationPieChart
                    client:only="react"
                    labels={chartLabels.allocation}
                    data={{
                      public: 90,
                      team: {
                        operations: 2,
                        tech: 2,
                        marketing: 2,
                        investors: 4,
                      },
                    }}
                  />
                </div>

                <h3 class="text-lg font-semibold mb-3">{whitepaperMessages?.content?.tokenomics?.phase?.title || '2.3 6 階段減半機制'}</h3>
                <div class="mb-4">
                  {(() => {
                    const lines = toLines(whitepaperMessages?.content?.tokenomics?.phase?.description || []);
                    const { isTable, tableRows, restLines } = parseTableLines(lines);
                    
                    if (isTable && tableRows.length > 0) {
                      const headerRow = tableRows[0];
                      const dataRows = tableRows.slice(1).filter(row => !row.every(cell => /^:?-+:?$/.test(cell))); // 過濾分隔符行
                      
                      return (
                        <>
                          {restLines.map((line: string) => {
                            if (line.trim() === '') return <br />;
                            if (line.startsWith('- ')) return <li class="ml-4 mb-1" set:html={toHTML(line)} />;
                            return <p class="mb-2" set:html={toHTML(line)} />;
                          })}
                          <div class="overflow-x-auto my-4">
                            <table class="w-full min-w-[400px] text-sm border-collapse">
                              <thead class="bg-black/5 dark:bg-black/10 text-left">
                                <tr>
                                  {headerRow.map((cell: string) => (
                                    <th class="px-3 py-2 border border-card-ring font-semibold" set:html={toHTML(cell)}></th>
                                  ))}
                                </tr>
                              </thead>
                              <tbody>
                                {dataRows.map((row: string[]) => (
                                  <tr class="border-b border-card-ring even:bg-black/5 dark:even:bg-black/10">
                                    {row.map((cell: string) => (
                                      <td class="px-3 py-2 border border-card-ring" set:html={toHTML(cell)}></td>
                                    ))}
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </>
                      );
                    }
                    
                    return lines.map((item: string) => {
                      if (item.trim() === '') return <br />;
                      if (item.startsWith('- ')) return <li class="ml-4 mb-1" set:html={toHTML(item)} />;
                      return <p class="mb-2" set:html={toHTML(item)} />;
                    });
                  })()}
                </div>
                
                <div class="my-6 p-4 bg-green-50 dark:bg-green-950/20 border border-green-200 dark:border-green-900 rounded-lg">
                  {toLines(whitepaperMessages?.content?.tokenomics?.phase?.value_logic || []).map((item: string) => {
                    if (item.trim() === '') {
                      return <br />;
                    }
                    return <p class="mb-2" set:html={toHTML(item)} />;
                  })}
                </div>

                <!-- 圖表：6 階段減半機制圖（位置：第二章 2.3「6 階段減半機制」→ 表格之後） -->
                <div class="chart-container my-6">
                  <PhaseReductionChart
                    client:only="react"
                    labels={chartLabels.phase}
                    data={[
                      { phase: 1, range: '0 ~ 4.5B', ratio: 1.0 },
                      { phase: 2, range: '4.5B ~ 6.75B', ratio: 0.5 },
                      { phase: 3, range: '6.75B ~ 7.875B', ratio: 0.25 },
                      { phase: 4, range: '7.875B ~ 8.4375B', ratio: 0.125 },
                      { phase: 5, range: '8.4375B ~ 8.71875B', ratio: 0.0625 },
                      { phase: 6, range: '8.71875B ~ 9B', ratio: 0.03125 },
                    ]}
                  />
                </div>
              </section>

              <!-- 三、技術架構 -->
              <section id="architecture" class="prose dark:prose-invert max-w-none">
                <h2 class="text-xl font-semibold mb-4" set:html={brandify(whitepaperMessages?.sections?.architecture || '')}></h2>
                
                <h3 class="text-lg font-semibold mb-3">{whitepaperMessages?.content?.architecture?.blockchain?.title || '3.1 區塊鏈選擇：Binance Smart Chain (BSC)'}</h3>
                <div class="mb-4">
                  {(() => {
                    const lines = toLines(whitepaperMessages?.content?.architecture?.blockchain?.why || []);
                    const { isTable, tableRows, restLines } = parseTableLines(lines);
                    
                    if (isTable && tableRows.length > 0) {
                      const headerRow = tableRows[0];
                      const dataRows = tableRows.slice(1).filter(row => !row.every(cell => /^:?-+:?$/.test(cell))); // 過濾分隔符行
                      
                      return (
                        <>
                          {restLines.map((line: string) => {
                            if (line.trim() === '') return <br />;
                            return <p class="mb-2" set:html={toHTML(line)} />;
                          })}
                          <div class="overflow-x-auto my-4">
                            <table class="w-full min-w-[400px] text-sm border-collapse">
                              <thead class="bg-black/5 dark:bg-black/10 text-left">
                                <tr>
                                  {headerRow.map((cell: string) => (
                                    <th class="px-3 py-2 border border-card-ring font-semibold" set:html={toHTML(cell)}></th>
                                  ))}
                                </tr>
                              </thead>
                              <tbody>
                                {dataRows.map((row: string[]) => (
                                  <tr class="border-b border-card-ring even:bg-black/5 dark:even:bg-black/10">
                                    {row.map((cell: string) => (
                                      <td class="px-3 py-2 border border-card-ring" set:html={toHTML(cell)}></td>
                                    ))}
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </>
                      );
                    }
                    
                    return lines.map((item: string) => {
                      if (item.trim() === '') return <br />;
                      return <p class="mb-2" set:html={toHTML(item)} />;
                    });
                  })()}
                </div>

                <h3 class="text-lg font-semibold mb-3">{whitepaperMessages?.content?.architecture?.contracts?.title || '3.2 智能合約架構'}</h3>
                <div class="mb-4">
                  {toLines(whitepaperMessages?.content?.architecture?.contracts?.description || []).map((item: string) => {
                    if (item.trim() === '') {
                      return <br />;
                    }
                    if (item.startsWith('- ')) {
                      return <li class="ml-4 mb-1" set:html={toHTML(item)} />;
                    }
                    return <p class="mb-2" set:html={toHTML(item)} />;
                  })}
                </div>

                <!-- 圖表：智能合約架構圖（位置：第三章 3.2「智能合約架構」→ 合約清單之後） -->
                <div class="my-6">
                  <ContractArchitectureDiagram labels={chartLabels.architecture} />
                </div>
              </section>

              <!-- 四、釋放機制 -->
              <section id="emission" class="prose dark:prose-invert max-w-none">
                <h2 class="text-xl font-semibold mb-4" set:html={brandify(whitepaperMessages?.sections?.emission || '')}></h2>
                
                <h3 class="text-lg font-semibold mb-3">{whitepaperMessages?.content?.emission?.public?.title || '4.1 公開發行（90%）'}</h3>
                
                <h4 class="text-base font-semibold mb-2">初始流動性</h4>
                <ul class="list-disc pl-6 mb-4">
                  {toLines(whitepaperMessages?.content?.emission?.public?.initial_liquidity || []).map((item: string) => (
                    <li class="mb-1" set:html={toHTML(item)} />
                  ))}
                </ul>

                <h4 class="text-base font-semibold mb-2">開盤防狙擊機制</h4>
                <ul class="list-disc pl-6 mb-4">
                  {toLines(whitepaperMessages?.content?.emission?.public?.launch_protection || []).map((item: string) => (
                    <li class="mb-1" set:html={toHTML(item)} />
                  ))}
                </ul>

                <h4 class="text-base font-semibold mb-2">釋放方式</h4>
                <div class="mb-4">
                  {toLines(whitepaperMessages?.content?.emission?.public?.release_methods || []).map((item: string) => {
                    if (item.trim() === '') {
                      return <br />;
                    }
                    if (item.match(/^\d+\.\s+\*\*/)) {
                      return <p class="mb-1" set:html={toHTML(item)} />;
                    }
                    return <p class="mb-2" set:html={toHTML(item)} />;
                  })}
                </div>

                <div class="my-6 p-4 bg-blue-50 dark:bg-blue-950/20 border border-blue-200 dark:border-blue-900 rounded-lg">
                  {toLines(whitepaperMessages?.content?.emission?.public?.cost_vs_price || []).map((item: string) => {
                    if (item.trim() === '') {
                      return <br />;
                    }
                    return <p class="mb-2" set:html={toHTML(item)} />;
                  })}
                </div>

                <h4 class="text-base font-semibold mb-2">提領機制</h4>
                <ul class="list-disc pl-6 mb-4">
                  {toLines(whitepaperMessages?.content?.emission?.public?.withdraw_mechanism || []).map((item: string) => (
                    <li class="mb-1" set:html={toHTML(item)} />
                  ))}
                </ul>

                <h4 class="text-base font-semibold mb-2">階段切換</h4>
                <ul class="list-disc pl-6 mb-6">
                  {toLines(whitepaperMessages?.content?.emission?.public?.phase_switch || []).map((item: string) => (
                    <li class="mb-1" set:html={toHTML(item)} />
                  ))}
                </ul>

                <h3 class="text-lg font-semibold mb-3">{whitepaperMessages?.content?.emission?.team?.title || '4.2 團隊配額（10%）'}</h3>
                <div class="mb-4">
                  {(() => {
                    const lines = toLines(whitepaperMessages?.content?.emission?.team?.vesting_rules || []);
                    const { isTable, tableRows, restLines } = parseTableLines(lines);
                    
                    if (isTable && tableRows.length > 0) {
                      const headerRow = tableRows[0];
                      const dataRows = tableRows.slice(1).filter(row => !row.every(cell => /^:?-+:?$/.test(cell))); // 過濾分隔符行
                      
                      return (
                        <>
                          {restLines.map((line: string) => {
                            if (line.trim() === '') return <br />;
                            if (line.startsWith('- ')) return <li class="ml-4 mb-1" set:html={toHTML(line)} />;
                            return <p class="mb-2" set:html={toHTML(line)} />;
                          })}
                          <div class="overflow-x-auto my-4">
                            <table class="w-full min-w-[400px] text-sm border-collapse">
                              <thead class="bg-black/5 dark:bg-black/10 text-left">
                                <tr>
                                  {headerRow.map((cell: string) => (
                                    <th class="px-3 py-2 border border-card-ring font-semibold" set:html={toHTML(cell)}></th>
                                  ))}
                                </tr>
                              </thead>
