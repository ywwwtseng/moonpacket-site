---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { defaultLocale } from '@/i18n/locales.config';
import { LOCALE_ORDER } from '@/config/locales';

// Try to infer language from URL or props, fallback to default
const { lang: propLang } = Astro.props;
let lang = propLang;

if (!lang) {
  // Try to parse from URL /zh-TW/xxx
  const parts = Astro.url.pathname.split('/').filter(Boolean);
  if (parts.length > 0 && LOCALE_ORDER.includes(parts[0])) {
    lang = parts[0];
  } else {
    lang = defaultLocale;
  }
}

// Simple i18n for 404 (can be moved to json later if needed)
const i18n = {
  'en-US': {
    title: 'Page Not Found',
    desc: "Sorry, the page doesn't exist or is not ready yet.",
    back: 'Go Back',
    home: 'Go to Home'
  },
  'zh-TW': {
    title: '頁面未找到',
    desc: '抱歉，您訪問的頁面不存在或尚未準備好。',
    back: '返回上一頁',
    home: '返回首頁'
  },
  'zh-CN': {
    title: '页面未找到',
    desc: '抱歉，您访问的页面不存在或尚未准备好。',
    back: '返回上一页',
    home: '返回首页'
  }
};

const t = i18n[lang as keyof typeof i18n] || i18n['en-US'];
const homeLink = `/${lang}/`;
---

<BaseLayout
  lang={lang}
  title={`404 · ${t.title}`}
  description={t.desc}
  canonicalUrl={Astro.url.href}
  allLocales={LOCALE_ORDER}
  noindex={true}
>
  <!-- Background Ambient Glows -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute top-1/3 left-1/4 w-[600px] h-[600px] bg-[var(--primary)] opacity-[0.04] rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/3 right-1/4 w-[500px] h-[500px] bg-[var(--gold)] opacity-[0.04] rounded-full blur-[100px]"></div>
        </div>

  <main class="min-h-[80vh] flex items-center justify-center p-4">
    <div class="w-full max-w-lg p-8 rounded-[2rem] bg-[var(--card-bg)]/80 backdrop-blur-xl border border-[var(--card-ring)] shadow-2xl shadow-black/10 text-center">
      
      <div class="inline-flex items-center justify-center w-20 h-20 mb-6 rounded-full bg-[var(--card-bg)] border border-[var(--card-ring)] text-4xl shadow-inner">
        🔍
      </div>

      <h1 class="text-4xl font-bold mb-4 text-[var(--text)]">404</h1>
      <h2 class="text-xl font-medium mb-4 text-[var(--text)]">{t.title}</h2>
      
      <p class="text-[var(--text-subtle)] text-lg mb-10 leading-relaxed">
        {t.desc}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="javascript:history.back()" class="px-6 py-3 rounded-xl border border-[var(--card-ring)] text-[var(--text)] hover:bg-[var(--card-bg)] transition-colors font-medium">
          {t.back}
        </a>
        <a href={homeLink} class="px-6 py-3 rounded-xl bg-[var(--primary)] text-white shadow-lg shadow-[var(--primary)]/20 hover:scale-105 transition-all font-medium">
          {t.home}
        </a>
      </div>

    </div>
  </main>
</BaseLayout>
